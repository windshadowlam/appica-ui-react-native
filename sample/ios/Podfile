# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'HelloWorld' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'HelloWorldTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # RN 0.75's bundled glog fails to compile on newer Xcode/SDK because it does
    # not pass HAVE_PTHREAD to its target. Define it so glog's mutex.h uses pthreads.
    installer.pods_project.targets.each do |target|
      if target.name == 'glog'
        target.build_configurations.each do |config|
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)', 'COCOAPODS=1']
          unless config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'].include?('HAVE_PTHREAD=1')
            config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'HAVE_PTHREAD=1'
          end
          unless config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'].include?('HAVE_PREAD=1')
            config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'HAVE_PREAD=1'
          end
          unless config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'].include?('HAVE_PWRITE=1')
            config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'HAVE_PWRITE=1'
          end
        end
      end
    end
  end
end
